# Copie para .streamlit/secrets.toml e preencha com os valores reais.
# NUNCA versionar o secrets.toml real (adicionar ao .gitignore).

[auth]
# Login é por CNPJ (mesmo CNPJ para todos) + senha — a senha determina o
# perfil. Troque os três placeholders abaixo pelos valores reais definidos
# por Mariano; não reaproveite os valores do PEX 2.0.
cnpj = "TROCAR_CNPJ"                 # só dígitos, sem pontuação (14 dígitos)
senha_consultor = "TROCAR_SENHA_CONSULTOR"
senha_diretor = "TROCAR_SENHA_DIRETOR"

[spaces]
# Credenciais do bucket DigitalOcean Spaces (mesmo bucket compartilhado com
# Mapa da Farmácia, PEX 2.0 etc — isolado sob project_prefix). Fonte
# principal de config.py:SpacesConfig; se esta seção não existir (ex:
# rodando fora do Streamlit), cai para variável de ambiente (ver .env.example).
endpoint_url = "TROCAR_ENDPOINT"
region = "TROCAR_REGION"
access_key = "TROCAR_ACCESS_KEY"
secret_key = "TROCAR_SECRET_KEY"
bucket = "TROCAR_BUCKET"
project_prefix = "Cota RMC"
