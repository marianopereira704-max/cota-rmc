# Copie para .env e preencha. NUNCA versionar o .env real.
#
# Fallback: config.py lê primeiro de st.secrets["spaces"] (ver
# .streamlit/secrets.toml.example), e só usa estas variáveis de ambiente se
# aquela seção não existir (ex: rodando fora do Streamlit).

SPACES_ENDPOINT_URL=TROCAR_ENDPOINT
SPACES_REGION=TROCAR_REGION
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_PROJECT_PREFIX=Cota RMC

# Padrões de negócio (opcionais — também editáveis em tela na aba Configurações)
DIAS_COBERTURA_PADRAO=7
MARGEM_SEGURANCA_RUPTURA=0.85
